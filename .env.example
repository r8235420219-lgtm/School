# ─── Server ───────────────────────────────────────────────
PORT=3000
# Public base URL of the deployed app (used for links/CORS). Optional in dev.
PUBLIC_URL=http://localhost:3000
# Secret used to sign session cookies. MUST be long & random in production.
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Student login ────────────────────────────────────────
# Shared class code students must type (with their name) to get in.
CLASS_CODE=school123

# ─── Admin / teacher ──────────────────────────────────────
# The admin's display name (auto-created as the single admin user).
ADMIN_NAME=Teacher
# Comma-separated numeric Telegram user IDs allowed to upload via the bot.
# Get yours by messaging @userinfobot on Telegram.
ADMIN_TELEGRAM_IDS=123456789

# ─── Telegram bot ─────────────────────────────────────────
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# ─── Groq (AI) ────────────────────────────────────────────
GROQ_API_KEY=
# Optional overrides. Comma-separated, tried in order; first live one wins.
GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile
GROQ_VISION_MODELS=qwen/qwen3.6-27b,meta-llama/llama-4-scout-17b-16e-instruct

# ─── Storage / DB paths ───────────────────────────────────
# Where SQLite db and uploaded files live (persistent disk in production).
DATA_DIR=./data
STORAGE_DIR=./storage
