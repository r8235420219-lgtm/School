{
  "name": "school-learning-platform",
  "version": "1.0.0",
  "description": "Mobile-first school learning platform: Telegram-uploaded content, AI Q&A (Groq), global chat, reading analytics.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,bot -c blue,magenta \"npm:dev:web\" \"npm:dev:bot\"",
    "dev:web": "node --import tsx --watch src/server.ts",
    "dev:bot": "node --import tsx bot/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "concurrently -n web,bot -c blue,magenta \"node --import tsx src/server.ts\" \"node --import tsx bot/index.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@grammyjs/conversations": "^2.0.1",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "grammy": "^1.34.0",
    "openai": "^4.85.1",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
